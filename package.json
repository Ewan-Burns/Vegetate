{
  "name": "vegetate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:chatgpt && tsc --noEmit && vite build && node scripts/build-worker.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "build:chatgpt": "node scripts/build-chatgpt.mjs",
    "postinstall": "npm run build:chatgpt",
    "companion": "tsx companion/main.ts",
    "companion:check": "tsx companion/doctor.ts",
    "food:probe": "tsx scripts/probe-food-data.ts",
    "food:refresh": "tsx scripts/refresh-usda-catalog.ts",
    "food:products": "tsx scripts/probe-open-food-facts.ts",
    "food:benchmark": "node scripts/benchmark-food-generation.mjs"
  },
  "dependencies": {
    "@siwc/local": "file:vendor/siwc-local",
    "open": "11.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@netlify/functions": "6.0.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
